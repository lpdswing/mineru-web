# 数据库连接串（切换 SQLite / PostgreSQL 的唯一开关）
# 缺省使用 SQLite：sqlite:///./mineru.db
# 切换到 PostgreSQL 示例（驱动 psycopg2）：
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/mineru
# 也可写裸协议，会被自动规范为 postgresql+psycopg2://：
# DATABASE_URL=postgresql://user:password@localhost:5432/mineru
DATABASE_URL=sqlite:///./mineru.db

# MinIO 对象存储
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false

# 解析 Worker 并发（默认 1）
WORKER_CONCURRENCY=1

# 允许通过请求头 X-User 直接指定用户（仅测试/本地用）
AUTH_ALLOW_USER_HEADER=false
